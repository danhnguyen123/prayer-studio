# ============================================================================
# Env dành cho PRODUCTION (server Ubuntu/Docker). File này ĐƯỢC commit vào repo
# vì KHÔNG chứa secret. Khi deploy, docker-compose nạp cả `.env` (secret của bạn)
# LẪN file này; các key ở đây GHI ĐÈ `.env` → server dùng môi trường đã gộp.
#
# TUYỆT ĐỐI không đặt API key / mật khẩu ở đây (những thứ đó nằm trong `.env`,
# file `.env` không commit và được scp riêng lên server).
# ============================================================================

NODE_ENV=production
PYTHON_EXECUTABLE=python3
APP_PORT=4300
# Bắt buộc trong container để cổng publish (-p) và public IP truy cập được.
APP_HOST=0.0.0.0

# Media trên server nằm ở volume /media (mount từ /mnt/media, xem DEPLOY.md).
DEFAULT_VIDEO_DIR=/media/video
DEFAULT_IMAGE_DIR=/media/image
DEFAULT_MUSIC_PATH=/media/music/intro.MP3
DEFAULT_INTRO_SECONDS=8

# FPS video. 30 = mượt; 24 để bớt ~20% frame → render + ghép trên Lambda nhanh hơn.
# Đặt 24 vì hàm MAIN chỉ tối đa 3008MB (~1.7 vCPU) — cần giảm tải bước ghép.
VIDEO_FPS=24

# Chất lượng/kích thước encode chunk (Lambda). crf cao hơn = nhẹ hơn → MAIN ghép/upload
# nhanh hơn (20=đẹp, 23=nhẹ vẫn tốt). Preset chỉ ảnh hưởng tốc độ render chunk.
REMOTION_CRF=23
# REMOTION_X264_PRESET=veryfast
