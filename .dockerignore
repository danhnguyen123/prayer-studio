# Allowlist build context: Docker only receives files that the image actually needs.
# This keeps deploys small even when the server checkout contains uploads, renders,
# virtual environments, caches, backups, or other runtime data.
**

!.dockerignore
!Dockerfile
!Dockerfile.batch
!package.json
!package-lock.json
!requirements.txt
!tsconfig.json
!vite.config.ts
!run.py

!web/
!web/**
!server/
!server/**
!src/
!src/**
!configs/
!configs/**
!personas/
!personas/**
!worker/
!worker/**
