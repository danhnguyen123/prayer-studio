# Official OpenAI Responses API is the default provider. Backend only.
OPENAI_API_KEY=
OPENAI_API_FILE=API_OPENAI.txt
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_BATCH_POLL_MS=10000

# Optional Kie fallback. Never prefix server secrets with VITE_.
KIE_API_KEY=
KIE_API_FILE=API_KIE.txt
KIE_API_URL=https://api.kie.ai/codex/v1/responses
KIE_MODEL=gpt-5-6-terra

# Optional: absolute path to python.exe if Python is not available on PATH.
PYTHON_EXECUTABLE=python

APP_PORT=4300

# Bảo mật khi mở ra public IP:port — BẮT BUỘC đặt cả hai để bật Basic Auth.
# Bỏ trống = KHÔNG có xác thực (chỉ dùng khi chạy local).
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASS=

# --- Đường dẫn media ---
# Local (Windows): dùng ổ D. Trên server Ubuntu (Docker) trỏ vào volume /media (xem DEPLOY.md):
#   DEFAULT_VIDEO_DIR=/media/video
#   DEFAULT_IMAGE_DIR=/media/image
#   DEFAULT_MUSIC_PATH=/media/music/intro.MP3
#   PYTHON_EXECUTABLE=python3
DEFAULT_VIDEO_DIR=D:\Materials\Video 4K
DEFAULT_IMAGE_DIR=D:\Materials\Pray\Image
DEFAULT_MUSIC_PATH=
DEFAULT_INTRO_SECONDS=8

# Remotion Lambda. Keep these values on the backend only.
REMOTION_AWS_REGION=ap-southeast-1
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
# Or leave the three credential fields blank and use an AWS_PROFILE.
# AWS_PROFILE=your-profile
REMOTION_FUNCTION_NAME=remotion-render-4-0-523-mem2048mb-disk10240mb-900sec
REMOTION_RENDERER_FUNCTION_NAME=remotion-render-4-0-523-mem2048mb-disk10240mb-900sec
REMOTION_SITE_NAME=youtube-pray-generation
# Optional: reuse an already deployed Remotion site instead of auto-deploying it.
REMOTION_SERVE_URL=
REMOTION_CONCURRENCY=200
