# Official OpenAI Responses API is the default provider. Backend only.
OPENAI_API_KEY=
OPENAI_API_FILE=API_OPENAI.txt
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_BATCH_POLL_MS=10000

# Optional Kie fallback. Never prefix server secrets with VITE_.
KIE_API_KEY=
KIE_API_FILE=API_KIE.txt
KIE_API_URL=https://api.kie.ai/codex/v1/responses
KIE_MODEL=gpt-5-6-terra

# Optional: absolute path to python.exe if Python is not available on PATH.
PYTHON_EXECUTABLE=python

APP_PORT=4300

# Bảo mật khi mở ra public IP:port — BẮT BUỘC đặt cả hai để bật Basic Auth.
# Bỏ trống = KHÔNG có xác thực (chỉ dùng khi chạy local).
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASS=

# --- Đường dẫn media ---
# Local (Windows): dùng ổ D. Trên server Ubuntu (Docker) trỏ vào volume /media (xem DEPLOY.md):
#   DEFAULT_VIDEO_DIR=/media/video
#   DEFAULT_IMAGE_DIR=/media/image
#   DEFAULT_MUSIC_PATH=/media/music/intro.MP3
#   PYTHON_EXECUTABLE=python3
DEFAULT_VIDEO_DIR=D:\Materials\Video 4K
DEFAULT_IMAGE_DIR=D:\Materials\Pray\Image
DEFAULT_MUSIC_PATH=
DEFAULT_INTRO_SECONDS=8

# AWS credentials chỉ tồn tại ở backend; không commit giá trị thật.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1

# AWS Batch + FFmpeg (tối đa 5 EC2 Spot worker ARM, mỗi worker 4 vCPU).
# Bucket, queue và job definition được tạo bởi infra/aws-batch-one-worker.yml.
AWS_BATCH_REGION=ap-southeast-1
AWS_BATCH_BUCKET=
AWS_BATCH_JOB_QUEUE=
AWS_BATCH_JOB_DEFINITION=
AWS_BATCH_POLL_MS=10000
AWS_BATCH_TIMEOUT_SECONDS=7200
AWS_BATCH_RETRY_ATTEMPTS=2
UPLOAD_RETENTION_HOURS=24
UPLOAD_CLEANUP_INTERVAL_HOURS=1
FFMPEG_CRF=20
FFMPEG_PRESET=veryfast
